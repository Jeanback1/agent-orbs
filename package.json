{
  "name": "agent-orbs",
  "version": "1.0.0",
  "description": "Local observatory that shows each Claude Code and Codex terminal session as an animated particle orb.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jeanback1/agent-orbs.git"
  },
  "os": [
    "linux"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "install:hooks": "node scripts/hooks.mjs install",
    "remove:hooks": "node scripts/hooks.mjs remove",
    "install:service": "node scripts/service.mjs install",
    "remove:service": "node scripts/service.mjs remove"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "fastify": "^5.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  }
}
